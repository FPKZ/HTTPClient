# Variáveis de Ambiente do Supabase
# Renomeie este arquivo para .env e preencha com as credenciais do seu projeto Supabase

# URL do projeto (Ex: https://xyz.supabase.co)
SUPABASE_URL="sua-url-do-supabase-aqui"

# Chave anônima (anon/public key) para acessos via cliente/API
SUPABASE_ANON_KEY="sua-chave-anon-aqui"
